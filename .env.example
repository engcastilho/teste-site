# -----------------------------------------------------------------------------
# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings › API). Nunca versione o .env.local.
# -----------------------------------------------------------------------------

# URL do projeto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública "anon" / "publishable". É segura no navegador porque o acesso
# é limitado pelas políticas de Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço público do site, usado no sitemap e no Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave secreta "service_role". NÃO é usada pelo site; serve apenas para o
# script local `npm run create-admin`. Nunca configure na Vercel nem use
# prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
